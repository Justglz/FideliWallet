# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# Jeton partagé avec Apple Wallet pour authentifier les mises à jour de cartes (obligatoire)
AUTH_TOKEN=changez-moi

# Mot de passe du tableau de bord super-admin
SUPER_ADMIN_PASS=changez-moi

# Emails (Resend)
RESEND_API_KEY=
MAIL_FROM=noreply@votre-domaine.com
CONTACT_EMAIL=contact@votre-domaine.com

# Apple Wallet
APPLE_PASS_TYPE_ID=pass.com.votre-organisation.fideliwallet
APNS_P12_PASSPHRASE=

# Google Wallet
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json

# Stripe (facturation des commerçants)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Chemins (optionnel)
DB_PATH=./fideli.db
BACKUP_DIR=./backups
